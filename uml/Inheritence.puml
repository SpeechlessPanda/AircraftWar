@startuml
'https://plantuml.com/class-diagram

abstract class AbstractFlyingObject
{
    # locationX:int
    # locationY:int
    # speedX:int
    # speedY:int
    # image:BufferedImage
    # width:int
    # height:int
    # isValid:boolean

    + AbstractFlyingObject()
    + AbstractFlyingObject(int locationX, int locationY, int speedX, int speedY)
    + forward():void
    + crash(AbstractFlyingObject flyingObject):boolean
    + setLocation(double locationX, double locationY):void
    + getLocationX():int
    + getLocationY():int
    + getSpeedY():int
    + getImage():BufferedImage
    + getWidth():int
    + getHeight():int
    + notValid():boolean
    + vanish():void
}

interface PropObserver {
    + onBomb(context:BombEffectContext):void
    + onFreeze(context:FreezeEffectContext):void
}

abstract class Game {
    + action():void
}

class EasyGame
class NormalGame
class HardGame

Game <|-- EasyGame
Game <|-- NormalGame
Game <|-- HardGame
abstract class AbstractAircraft
{
	# maxHp:int
    # hp:int
    # shootNum:int
    # power:int
    # direction:int
    # shootStrategy:ShootStrategy
    - shootingDisabledByFreeze:boolean
    + AbstractAircraft(int locationX, int locationY, int speedX, int speedY, int hp)
    + AbstractAircraft(int locationX, int locationY, int speedX, int speedY, int hp, int shootNum, int power, int direction)
    + decreaseHp(int decrease):void
    + getHp():int
    + increaseHp(int increase):void
    + shoot():List<BaseBullet>
    + setShootStrategy(shootStrategy:ShootStrategy):void
    + getShootNum():int
    + getPower():int
    + getDirection():int
    + setShootNum(shootNum:int):void
    # freezeMovementAndShootingTemporarily(context:FreezeEffectContext, durationMillis:long):void
 }


class HeroAircraft {
    - {static} volatile heroAircraft:HeroAircraft
    - {static} INIT_LOCATION_X:int
    - {static} INIT_LOCATION_Y:int
    - {static} INIT_SPEED_X:int
    - {static} INIT_SPEED_Y:int
    - {static} INIT_HP:int
    - {static} INIT_SHOOT_NUM:int
    - {static} INIT_POWER:int
    - {static} INIT_DIRECTION:int
    - HeroAircraft()
    + {static} getInstance():HeroAircraft
    + forward():void
}

AbstractAircraft <|-- HeroAircraft
PropObserver <|.. AbstractAircraft

class MobEnemy {
    - {static} DEFAULT_SPEED_X:int
    - {static} DEFAULT_SPEED_Y:int
    - {static} DEFAULT_HP:int
    + {static} createDefault(int locationX, int locationY):MobEnemy
    + MobEnemy(int locationX, int locationY, int speedX, int speedY, int hp)
    + forward():void
}
AbstractAircraft <|-- MobEnemy

class EliteEnemy {
    - {static} DEFAULT_SPEED_X:int
    - {static} DEFAULT_SPEED_Y:int
    - {static} DEFAULT_HP:int
    - {static} DEFAULT_SHOOT_NUM:int
    - {static} DEFAULT_POWER:int
    - {static} DEFAULT_DIRECTION:int
    + {static} createDefault(int locationX, int locationY):EliteEnemy
    + EliteEnemy(int locationX, int locationY, int speedX, int speedY, int hp)
    + forward():void
    + onFreeze(context:FreezeEffectContext):void
}
AbstractAircraft <|-- EliteEnemy

