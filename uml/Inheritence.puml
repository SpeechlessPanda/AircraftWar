AbstractAircraft <|-- BossEnemy

abstract class BaseBullet
{
    - power:int
    - frozenBySupply:boolean
    + BaseBullet(int locationX, int locationY, int speedX, int speedY, int power)
    + forward():void
	+ getPower():int
    + isFrozenBySupply():boolean
    + isTemporarySpeedLocked():boolean
    + onFreeze(context:FreezeEffectContext):void
}

class HeroBullet {
    + HeroBullet(int locationX, int locationY,
     int speedX, int speedY, int power)
}

class EnemyBullet {
    + EnemyBullet(int locationX, int locationY,
     int speedX, int speedY, int power)
}

BaseBullet <|-- HeroBullet
BaseBullet <|-- EnemyBullet
PropObserver <|.. BaseBullet

abstract class AbstractProp {
    + AbstractProp(int locationX, int locationY, int speedX, int speedY)
    + forward():void
    + {abstract} active(HeroAircraft heroAircraft):void
}
AbstractFlyingObject <|-- AbstractProp

class BloodSupply {
    - {static} HEALING_VALUE:int
    - {static} DEFAULT_SPEED_X:int
    - {static} DEFAULT_SPEED_Y:int
    + {static} createDefault(int locationX, int locationY):BloodSupply
    + BloodSupply(int locationX, int locationY, int speedX, int speedY)
    + active(HeroAircraft heroAircraft):void
}
AbstractProp <|-- BloodSupply

class FireSupply {
    - {static} DEFAULT_SPEED_X:int
    - {static} DEFAULT_SPEED_Y:int
    + {static} createDefault(int locationX, int locationY):FireSupply
    + FireSupply(int locationX, int locationY, int speedX, int speedY)
    + active(HeroAircraft heroAircraft):void
}
AbstractProp <|-- FireSupply

class FirePlusSupply {
    - {static} DEFAULT_SPEED_X:int
    - {static} DEFAULT_SPEED_Y:int
    + {static} createDefault(int locationX, int locationY):FirePlusSupply
    + FirePlusSupply(int locationX, int locationY, int speedX, int speedY)
    + active(HeroAircraft heroAircraft):void
}
AbstractProp <|-- FirePlusSupply

class BombSupply {
    - {static} DEFAULT_SPEED_X:int
    - {static} DEFAULT_SPEED_Y:int
    + {static} createDefault(int locationX, int locationY):BombSupply
    + BombSupply(int locationX, int locationY, int speedX, int speedY)
    + active(HeroAircraft heroAircraft):void
}
AbstractProp <|-- BombSupply

class FreezeSupply {
    - {static} DEFAULT_SPEED_X:int
    - {static} DEFAULT_SPEED_Y:int
    + {static} createDefault(int locationX, int locationY):FreezeSupply
    + FreezeSupply(int locationX, int locationY, int speedX, int speedY)
    + active(HeroAircraft heroAircraft):void
}
AbstractProp <|-- FreezeSupply

AbstractFlyingObject <|-- AbstractAircraft
AbstractFlyingObject <|-- BaseBullet

@enduml
